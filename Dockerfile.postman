FROM node:16

# 安装必要的依赖
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    libgtk-3-0 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxi6 \
    libxtst6 \
    libnss3 \
    libcups2 \
    libxss1 \
    libxrandr2 \
    libasound2 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libpangocairo-1.0-0 \
    libgtk-3-0 \
    libgbm1 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

# 下载并安装 Postman
RUN wget https://dl.pstmn.io/download/latest/linux64 -O postman.tar.gz \
    && tar -xzf postman.tar.gz \
    && rm postman.tar.gz \
    && mv Postman /opt/ \
    && ln -s /opt/Postman/Postman /usr/bin/postman

# 创建非 root 用户
RUN useradd -m postman

# 设置工作目录
WORKDIR /home/postman

# 切换到非 root 用户
USER postman

# 启动 Postman
CMD ["postman"] 